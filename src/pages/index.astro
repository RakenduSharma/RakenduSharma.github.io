
---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="page">
    <header class="navbar">
      <a class="logo" href="/">Rakendu<span>Labs.</span></a>
      <nav>
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="https://github.com/RakenduSharma" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="eyebrow">ENGINEERING • AI • INNOVATION</div>
        <h1>Building ideas into <span>working solutions.</span></h1>
        <p>
          Welcome to Rakendu Labs — a personal engineering lab
          exploring Artificial Intelligence, Embedded Systems,
          and intelligent product development.
        </p>
        <a class="button" href="#projects">Explore Projects →</a>
      </section>

      <section id="projects" class="projects">
        <div class="section-label">01 / OUR WORK</div>
        <h2>Featured Projects</h2>

        <article class="project-card">
          <div class="project-icon">🇩🇪</div>
          <div>
            <span class="status">PROTOTYPE IN DEVELOPMENT</span>
            <h3>BriefPilot Deutsch</h3>
            <p>
              An AI-powered German writing assistant designed
              to help DTZ B1 learners improve their letters
              through grammar feedback, corrections,
              model answers, and personalized learning tips.
            </p>
            <div class="tags">
              <span>Generative AI</span>
              <span>Python</span>
              <span>Language Learning</span>
            </div>
          </div>
        </article>
      </section>

      <section id="about" class="about">
        <div class="section-label">02 / ABOUT THE LAB</div>
        <h2>Engineering meets curiosity.</h2>
        <p>
          Rakendu Labs is a space for practical experimentation,
          continuous learning, and turning real-world problems
          into working technology.
        </p>
        <p>
          Built on experience in software engineering,
          embedded technologies, and technical project leadership,
          with a growing focus on AI-enabled products.
        </p>
      </section>
    </main>

    <footer>
      <span>© 2026 Rakendu Labs</span>
      <span>Learn. Build. Share.</span>
    </footer>
  </div>
</Layout>

<style>
  :global(body) {
    margin: 0;
    background: #f6f8fc;
    color: #17233b;
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.7;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .page {
    max-width: 1100px;
    margin: auto;
    padding: 0 28px;
  }

  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 28px 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .logo {
    font-size: 24px;
    font-weight: 800;
    color: #17233b;
    text-decoration: none;
  }

  .logo span, h1 span {
    color: #2563eb;
  }

  nav {
    display: flex;
    gap: 26px;
  }

  nav a {
    color: #475569;
    text-decoration: none;
    font-size: 14px;
  }

  nav a:hover {
    color: #2563eb;
  }

  .hero {
    padding: 100px 0 110px;
    max-width: 780px;
  }

  .eyebrow, .section-label {
    color: #2563eb;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.13;
    letter-spacing: -2px;
    margin: 24px 0;
  }

  .hero p {
    font-size: 19px;
    color: #64748b;
    max-width: 650px;
    margin-bottom: 36px;
  }

  .button {
    display: inline-block;
    padding: 13px 25px;
    background: #2563eb;
    color: white;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
  }

  .button:hover {
    background: #1d4ed8;
  }

  .projects, .about {
    padding: 35px 0 85px;
  }

  h2 {
    font-size: 34px;
    margin: 12px 0 30px;
  }

  .project-card {
    display: flex;
    gap: 25px;
    background: white;
    padding: 38px;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 8px 30px rgba(30, 41, 59, 0.04);
  }

  .project-icon {
    font-size: 42px;
  }

  .status {
    font-size: 11px;
    font-weight: 800;
    color: #2563eb;
    letter-spacing: 1px;
  }

  h3 {
    font-size: 26px;
    margin: 12px 0;
  }

  .project-card p, .about p {
    color: #64748b;
    max-width: 700px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
  }

  .tags span {
    padding: 5px 12px;
    background: #eff6ff;
    color: #1d4ed8;
    border-radius: 20px;
    font-size: 12px;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 30px 0;
    border-top: 1px solid #e2e8f0;
    color: #94a3b8;
    font-size: 13px;
  }

  @media (max-width: 600px) {
    .navbar {
      flex-wrap: wrap;
    }

    nav {
      gap: 16px;
    }

    .hero {
      padding: 65px 0;
    }

    .project-card {
      flex-direction: column;
      padding: 25px;
    }

    h2 {
      font-size: 28px;
    }
  }
</style>
